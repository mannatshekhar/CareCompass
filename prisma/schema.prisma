// Local dev uses SQLite (zero setup, a single file). For production, swap
// the datasource below to Postgres (e.g. a free Supabase, Neon, or Railway
// instance) — SQLite is fine for building/testing but not for a real
// multi-user deployment. Swapping only requires changing `provider` and
// `DATABASE_URL` in .env, no schema changes needed for these models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Standard Auth.js (NextAuth v5) models — do not rename fields, the
// Prisma adapter expects these exact shapes. ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Our own addition: one profile per user, for checkup reminders
  profile       CheckupProfile?

  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Our product-specific model ----

model CheckupProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // How often the user wants to be reminded to get checked up again
  reminderFrequencyMonths Int       @default(6)

  // When they last completed (or told us they completed) a checkup
  lastCheckupAt           DateTime?

  // When the next reminder email should go out — computed and stored so a
  // scheduled job can just query "remindAt <= now" instead of recomputing
  remindAt                DateTime?

  // Whether they've opted in to reminder emails at all
  remindersEnabled        Boolean   @default(true)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}